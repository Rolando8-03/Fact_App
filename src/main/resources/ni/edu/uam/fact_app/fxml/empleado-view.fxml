<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="550.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.fact_app.controller.EmpleadoController">

    <!-- TÍTULO -->
    <top>

        <Label style="-fx-font-size: 22px;                       -fx-font-weight: bold;" text="Gestión de empleados" BorderPane.alignment="CENTER">

            <padding>

                <Insets bottom="15" left="10" right="10" top="15" />

            </padding>

        </Label>

    </top>


    <!-- CONTENIDO -->
    <center>

        <VBox spacing="15">

            <padding>

                <Insets bottom="20" left="25" right="25" top="15" />

            </padding>


            <!--
                FORMULARIO EN DOS COLUMNAS

                Izquierda:
                Nombres
                Apellidos
                Cargo

                Derecha:
                Fecha
                Estado
            -->
            <HBox alignment="TOP_LEFT" spacing="35">


                <!-- COLUMNA IZQUIERDA -->
                <GridPane hgap="10" prefWidth="430" vgap="12" HBox.hgrow="ALWAYS">


                    <columnConstraints>

                        <ColumnConstraints minWidth="95" prefWidth="95" />

                        <ColumnConstraints hgrow="ALWAYS" minWidth="280" prefWidth="300" />

                    </columnConstraints>


                    <!-- NOMBRES -->

                    <Label text="Nombres *:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

                    <TextField fx:id="txtNombres" promptText="Nombres del empleado" GridPane.columnIndex="1" GridPane.rowIndex="0" />


                    <!-- APELLIDOS -->

                    <Label text="Apellidos *:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                    <TextField fx:id="txtApellidos" promptText="Apellidos del empleado" GridPane.columnIndex="1" GridPane.rowIndex="1" />


                    <!-- CARGO -->

                    <Label text="Cargo *:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

                    <ComboBox fx:id="cmbCargo" prefHeight="26.0" prefWidth="345.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>

                </GridPane>


                <!-- COLUMNA DERECHA -->
                <GridPane hgap="10" prefWidth="380" vgap="12" HBox.hgrow="ALWAYS">


                    <columnConstraints>

                        <ColumnConstraints minWidth="145" prefWidth="145" />

                        <ColumnConstraints hgrow="ALWAYS" minWidth="190" prefWidth="210" />

                    </columnConstraints>


                    <!-- FECHA -->

                    <Label text="Fecha contratación *:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

                    <DatePicker fx:id="dpFechaContratacion" onAction="#validarFecha" prefWidth="210" promptText="Seleccione una fecha" GridPane.columnIndex="1" GridPane.rowIndex="0" />


                    <!-- ESTADO -->

                    <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                    <CheckBox fx:id="chkActivo" text="Empleado activo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
   
   
                   <Region GridPane.rowIndex="2" />
   
   
                   <Label style="-fx-text-fill: #b00020;" text="* Campos obligatorios" GridPane.rowIndex="3" />
   
   
                   <Button fx:id="btnGuardar" onAction="#guardar" prefHeight="26.0" prefWidth="255.0" text="Guardar" GridPane.columnIndex="1" GridPane.rowIndex="3">
   
   
                       <graphic>
   
                           <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
   
                               <image>
   
                                   <Image url="@../icons/agregar.png" />
   
                               </image>
   
                           </ImageView>
   
                       </graphic>
   
                   </Button>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>

                </GridPane>

            </HBox>


            <!-- CAMPOS OBLIGATORIOS + GUARDAR -->
            <HBox alignment="CENTER_LEFT" spacing="15" />


            <!-- TABLA -->
            <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS">


                <columns>

                    <TableColumn fx:id="colNombres" prefWidth="215" text="Nombres" />

                    <TableColumn fx:id="colApellidos" prefWidth="215" text="Apellidos" />

                    <TableColumn fx:id="colCargo" prefWidth="210" text="Cargo" />

                    <TableColumn fx:id="colFecha" prefWidth="210" text="Fecha de contratación" />

                </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

            </TableView>

        </VBox>

    </center>

</BorderPane>
