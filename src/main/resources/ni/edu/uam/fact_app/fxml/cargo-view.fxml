<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" prefHeight="550" prefWidth="720" fx:controller="ni.edu.uam.fact_app.controller.CargoController">
  <top>
    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Gestión de cargos" BorderPane.alignment="CENTER">
      <padding>
        <Insets bottom="15" left="10" right="10" top="15"/>
      </padding>
    </Label>
  </top>
  <center>
    <VBox spacing="15">
      <padding>
        <Insets bottom="20" left="20" right="20" top="15"/>
      </padding>
      <GridPane hgap="10" prefHeight="65.0" prefWidth="542.0" vgap="12">
        <columnConstraints>
          <ColumnConstraints minWidth="105" prefWidth="105"/>
          <ColumnConstraints hgrow="ALWAYS" minWidth="350" prefWidth="350"/>
        </columnConstraints>
        <Label text="Nombre *:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombre" promptText="Nombre del cargo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Descripción *:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtDescripcion" promptText="Descripción del cargo" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <rowConstraints>
          <RowConstraints/>
          <RowConstraints/>
        </rowConstraints>
      </GridPane>
      <HBox alignment="CENTER_LEFT" spacing="15">
        <Label style="-fx-text-fill: #b00020;" text="* Campos obligatorios"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnGuardar" onAction="#guardar" text="Guardar">
          <graphic>
            <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
              <image>
                <Image url="@../icons/agregar.png"/>
              </image>
            </ImageView>
          </graphic>
        </Button>
      </HBox>
      <HBox spacing="8" alignment="CENTER_LEFT">
      <Label text="Buscar:"/>
      <ComboBox fx:id="cmbCriterio" prefWidth="100"/>
      <TextField fx:id="txtBuscar" promptText="ID o nombre" HBox.hgrow="ALWAYS"/>
      <Button text="Buscar…" onAction="#buscar"/>
        <Button text="Restablecer" onAction="#restablecerFiltros"/>
    </HBox>
      <HBox spacing="10" alignment="CENTER_LEFT">
      <Region HBox.hgrow="ALWAYS"/>
      <Button text="Nuevo" onAction="#limpiar"><tooltip><Tooltip text="Limpiar el formulario para agregar un registro"/></tooltip></Button>
      <Button text="Eliminar" onAction="#eliminar"/>
      <Button text="Refrescar" onAction="#refrescar"/>
    </HBox>
      <TableView fx:id="tblCargos" VBox.vgrow="ALWAYS" minHeight="140">
        <columns>
          <TableColumn fx:id="colId" prefWidth="55" minWidth="45" text="ID"/>
          <TableColumn fx:id="colNombre" prefWidth="240" text="Nombre"/>
          <TableColumn fx:id="colDescripcion" prefWidth="365" text="Descripción"/>
        </columns>
        <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <contextMenu>
          <ContextMenu>
            <items>
        <MenuItem text="Nuevo registro" onAction="#limpiar"/>
        <MenuItem text="Eliminar seleccionado" onAction="#eliminar"/>
        <SeparatorMenuItem/>
        <MenuItem text="Refrescar" onAction="#refrescar"/>
    </items>
          </ContextMenu>
        </contextMenu>
      </TableView>
      <Label fx:id="lblEstado" text="Nuevo registro"/>
    </VBox>
  </center>
</BorderPane>
