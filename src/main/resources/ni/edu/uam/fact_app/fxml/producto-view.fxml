<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" prefHeight="720" prefWidth="990" fx:controller="ni.edu.uam.fact_app.controller.ProductoController">
  <top>
    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Gestión de productos" BorderPane.alignment="CENTER">
      <padding>
        <Insets bottom="15" left="10" right="10" top="15"/>
      </padding>
    </Label>
  </top>
  <center>
    <VBox spacing="12">
      <padding>
        <Insets bottom="20" left="25" right="25" top="10"/>
      </padding>
      <HBox alignment="TOP_LEFT" spacing="30">
        <GridPane hgap="10" prefWidth="500" vgap="12">
          <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="300" prefWidth="300"/>
          </columnConstraints>
          <Label text="Código *:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
          <TextField fx:id="txtCodigo" promptText="Código del producto" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
          <Label text="Nombre *:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
          <TextField fx:id="txtNombre" promptText="Nombre del producto" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
          <Label text="Categoría *:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
          <ComboBox fx:id="cmbCategoria" prefHeight="26.0" prefWidth="335.0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
          <Label text="Precio *:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
          <TextField fx:id="txtPrecio" promptText="Precio de venta" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
          <Label text="Existencia *:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
          <TextField fx:id="txtExistencia" promptText="Cantidad disponible" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
          <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
          <CheckBox fx:id="chkActivo" text="Producto activo" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
          <Region GridPane.columnIndex="1" GridPane.rowIndex="6"/>
          <HBox alignment="CENTER_LEFT" prefHeight="26.0" prefWidth="217.0" spacing="20" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="7">
            <Label style="-fx-text-fill: #b00020;" text="* Campos obligatorios"/>
            <ComboBox fx:id="cmbEstado" prefWidth="110">
              <tooltip>
                <Tooltip text="Filtrar por estado"/>
              </tooltip>
            </ComboBox>
            <Button fx:id="btnGuardar" onAction="#guardar" text="Guardar">
              <graphic>
                <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                  <image>
                    <Image url="@../icons/agregar.png"/>
                  </image>
                </ImageView>
              </graphic>
            </Button>
          </HBox>
          <rowConstraints>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
          </rowConstraints>
        </GridPane>
        <VBox alignment="TOP_CENTER" prefWidth="420" spacing="10" HBox.hgrow="ALWAYS">
          <Label style="-fx-font-weight: bold;" text="Imagen del producto"/>
          <StackPane minHeight="235" minWidth="330" prefHeight="235" prefWidth="360" style="-fx-border-color: #b5b5b5; -fx-border-width: 1; -fx-background-color: white;">
            <ImageView fx:id="imgProducto" fitHeight="225" fitWidth="350" preserveRatio="true"/>
          </StackPane>
          <Button fx:id="btnImagen" onAction="#seleccionarImagen" text="Seleccionar imagen"/>
        </VBox>
      </HBox>
      <HBox spacing="8" alignment="CENTER_LEFT">
      <Label text="Buscar:"/>
      <ComboBox fx:id="cmbCriterio" prefWidth="100"/>
      <TextField fx:id="txtBuscar" promptText="ID o nombre" HBox.hgrow="ALWAYS"/>
      <Button text="Buscar…" onAction="#buscar"/>
        <Button text="Restablecer" onAction="#restablecerFiltros"/>
    </HBox>
      <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Categoría:"/><ComboBox fx:id="cmbFiltroCategoria" prefWidth="230"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Button text="Nuevo" onAction="#limpiar"><tooltip><Tooltip text="Limpiar el formulario para agregar un registro"/></tooltip></Button>
      <Button text="Actualizar" onAction="#actualizar"/>
        <Button text="Eliminar" onAction="#eliminar"/>
      <Button text="Refrescar" onAction="#refrescar"/>
    </HBox>
      <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS" minHeight="140">
        <columns>
          <TableColumn fx:id="colId" prefWidth="55" minWidth="45" text="ID"/>
          <TableColumn fx:id="colCodigo" prefWidth="150" text="Código"/>
          <TableColumn fx:id="colNombre" prefWidth="230" text="Nombre"/>
          <TableColumn fx:id="colCategoria" prefWidth="190" text="Categoría"/>
          <TableColumn fx:id="colPrecio" prefWidth="160" text="Precio"/>
          <TableColumn fx:id="colExistencia" prefWidth="160" text="Existencia"/>
          <TableColumn fx:id="colEstado" prefWidth="85" minWidth="65" text="Estado"/>
        </columns>
        <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <contextMenu>
          <ContextMenu>
            <items>
        <MenuItem text="Nuevo registro" onAction="#limpiar"/>
        <MenuItem text="Actualizar seleccionado" onAction="#actualizar"/>
            <MenuItem text="Eliminar seleccionado" onAction="#eliminar"/>
        <SeparatorMenuItem/>
        <MenuItem text="Refrescar" onAction="#refrescar"/>
    </items>
          </ContextMenu>
        </contextMenu>
      </TableView>
      <Label fx:id="lblEstado" text="Nuevo registro"/>
    </VBox>
  </center>
</BorderPane>
