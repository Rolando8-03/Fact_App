<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.fact_app.controller.ProductoController"
            prefWidth="950.0"
            prefHeight="650.0">

    <top>

        <Label text="Gestión de productos"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 22px; -fx-font-weight: bold;">

            <padding>
                <Insets top="15"
                        right="10"
                        bottom="15"
                        left="10"/>
            </padding>

        </Label>

    </top>

    <center>

        <VBox spacing="12">

            <padding>
                <Insets top="10"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <!-- Formulario e imagen -->
            <HBox spacing="30"
                  alignment="TOP_LEFT">

                <!-- Datos del producto -->
                <GridPane hgap="10"
                          vgap="12"
                          prefWidth="430">

                    <columnConstraints>

                        <ColumnConstraints minWidth="100"
                                           prefWidth="100"/>

                        <ColumnConstraints minWidth="300"
                                           prefWidth="300"
                                           hgrow="ALWAYS"/>

                    </columnConstraints>

                    <!-- Código -->
                    <Label text="Código *:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtCodigo"
                               promptText="Código del producto"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                    <!-- Nombre -->
                    <Label text="Nombre *:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <TextField fx:id="txtNombre"
                               promptText="Nombre del producto"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>

                    <!-- Categoría -->
                    <Label text="Categoría *:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <ComboBox fx:id="cmbCategoria"
                              prefWidth="300"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="2"/>

                    <!-- Precio -->
                    <Label text="Precio *:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="3"/>

                    <TextField fx:id="txtPrecio"
                               promptText="Precio de venta"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="3"/>

                    <!-- Existencia -->
                    <Label text="Existencia *:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4"/>

                    <TextField fx:id="txtExistencia"
                               promptText="Cantidad disponible"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="4"/>

                    <!-- Estado -->
                    <Label text="Estado:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="5"/>

                    <CheckBox fx:id="chkActivo"
                              text="Producto activo"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="5"/>

                </GridPane>

                <!-- Imagen del producto -->
                <VBox spacing="10"
                      alignment="TOP_CENTER"
                      prefWidth="420"
                      HBox.hgrow="ALWAYS">

                    <Label text="Imagen del producto"
                           style="-fx-font-weight: bold;"/>

                    <StackPane prefWidth="360"
                               prefHeight="235"
                               minWidth="360"
                               minHeight="235"
                               style="-fx-border-color: #b5b5b5;
                                      -fx-border-width: 1;
                                      -fx-background-color: white;">

                        <ImageView fx:id="imgProducto"
                                   fitWidth="350"
                                   fitHeight="225"
                                   preserveRatio="true"/>

                    </StackPane>

                    <Button fx:id="btnImagen"
                            text="Seleccionar imagen"
                            onAction="#seleccionarImagen"/>

                </VBox>

            </HBox>

            <!-- Información de campos obligatorios -->
            <Label text="* Campos obligatorios"
                   style="-fx-text-fill: #b00020;"/>

            <!-- Filtro y botón guardar -->
            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <CheckBox fx:id="chkVerTodos"
                          text="Ver todos"
                          selected="true"
                          onAction="#filtrarProductos"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnGuardar"
                        text="Guardar"
                        onAction="#guardar">

                    <graphic>

                        <ImageView fitWidth="18"
                                   fitHeight="18"
                                   preserveRatio="true">

                            <image>
                                <Image url="@../icons/agregar.png"/>
                            </image>

                        </ImageView>

                    </graphic>

                </Button>

            </HBox>

            <!-- Tabla -->
            <TableView fx:id="tblProductos"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colNombre"
                                 text="Nombre"
                                 prefWidth="190"/>

                    <TableColumn fx:id="colCategoria"
                                 text="Categoría"
                                 prefWidth="160"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colExistencia"
                                 text="Existencia"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colActivo"
                                 text="Activo"
                                 prefWidth="100"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>