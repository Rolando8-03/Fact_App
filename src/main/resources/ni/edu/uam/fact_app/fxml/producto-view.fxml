<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.fact_app.controller.ProductoController"
            prefWidth="900.0"
            prefHeight="650.0">

    <top>

        <Label text="Gestión de productos"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 22px; -fx-font-weight: bold;">

            <padding>
                <Insets top="15"
                        right="10"
                        bottom="15"
                        left="10"/>
            </padding>

        </Label>

    </top>

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <HBox spacing="25">

                <GridPane hgap="10"
                          vgap="12"
                          HBox.hgrow="ALWAYS">

                    <Label text="Código:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtCodigo"
                               promptText="Código del producto"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                    <Label text="Nombre:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <TextField fx:id="txtNombre"
                               promptText="Nombre del producto"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>

                    <Label text="Categoría:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <ComboBox fx:id="cmbCategoria"
                              prefWidth="250"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="2"/>

                    <Label text="Precio:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="3"/>

                    <TextField fx:id="txtPrecio"
                               promptText="Precio de venta"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="3"/>

                    <Label text="Existencia:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4"/>

                    <TextField fx:id="txtExistencia"
                               promptText="Cantidad disponible"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="4"/>

                    <Label text="Estado:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="5"/>

                    <CheckBox fx:id="chkActivo"
                              text="Producto activo"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="5"/>

                </GridPane>

                <VBox spacing="10"
                      alignment="CENTER"
                      prefWidth="220">

                    <Label text="Imagen del producto"/>

                    <ImageView fx:id="imgProducto"
                               fitWidth="180"
                               fitHeight="140"
                               preserveRatio="true"/>

                    <Button fx:id="btnImagen"
                            text="Seleccionar imagen"
                            onAction="#seleccionarImagen"/>

                </VBox>

            </HBox>

            <HBox spacing="10"
                  alignment="CENTER_RIGHT">

                <Button fx:id="btnGuardar"
                        text="Guardar"
                        onAction="#guardar"/>

                <Button fx:id="btnCerrar"
                        text="Cerrar"
                        onAction="#cerrar"/>

            </HBox>

            <TableView fx:id="tblProductos"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colNombre"
                                 text="Nombre"
                                 prefWidth="170"/>

                    <TableColumn fx:id="colCategoria"
                                 text="Categoría"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colExistencia"
                                 text="Existencia"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colActivo"
                                 text="Activo"
                                 prefWidth="90"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>