<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" prefHeight="510" prefWidth="720" fx:controller="ni.edu.uam.fact_app.controller.CategoriaController">
  <top>
    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Gestión de categorías" BorderPane.alignment="CENTER">
      <padding>
        <Insets bottom="15" left="10" right="10" top="15"/>
      </padding>
    </Label>
  </top>
  <center>
    <VBox spacing="15">
      <padding>
        <Insets bottom="20" left="25" right="25" top="15"/>
      </padding>
      <HBox alignment="CENTER_LEFT" spacing="25">
        <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
          <Label text="Nombre *:"/>
          <TextField fx:id="txtNombre" prefWidth="300" promptText="Nombre de la categoría" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
          <Label text="Estado:"/>
          <CheckBox fx:id="chkActiva" text="Categoría activa"/>
        </HBox>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="20">
        <Label style="-fx-text-fill: #b00020;" text="* Campos obligatorios"/>
        <ComboBox fx:id="cmbEstado" prefWidth="110">
          <tooltip>
            <Tooltip text="Filtrar por estado"/>
          </tooltip>
        </ComboBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnGuardar" onAction="#guardar" text="Guardar">
          <graphic>
            <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
              <image>
                <Image url="@../icons/agregar.png"/>
              </image>
            </ImageView>
          </graphic>
        </Button>
      </HBox>
      <HBox spacing="8" alignment="CENTER_LEFT">
      <Label text="Buscar:"/>
      <ComboBox fx:id="cmbCriterio" prefWidth="100"/>
      <TextField fx:id="txtBuscar" promptText="ID o nombre" HBox.hgrow="ALWAYS"/>
      <Button text="Buscar…" onAction="#buscar"/>
        <Button text="Restablecer" onAction="#restablecerFiltros"/>
    </HBox>
      <HBox spacing="10" alignment="CENTER_LEFT">
      <Region HBox.hgrow="ALWAYS"/>
      <Button text="Nuevo" onAction="#limpiar"><tooltip><Tooltip text="Limpiar el formulario para agregar un registro"/></tooltip></Button>
      <Button text="Actualizar" onAction="#actualizar"/>
        <Button text="Eliminar" onAction="#eliminar"/>
      <Button text="Refrescar" onAction="#refrescar"/>
    </HBox>
      <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS" minHeight="140">
        <columns>
          <TableColumn fx:id="colId" prefWidth="55" minWidth="45" text="ID"/>
          <TableColumn fx:id="colNombre" prefWidth="430" text="Nombre"/>
          <TableColumn fx:id="colEstado" prefWidth="85" minWidth="65" text="Estado"/>
        </columns>
        <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <contextMenu>
          <ContextMenu>
            <items>
        <MenuItem text="Nuevo registro" onAction="#limpiar"/>
        <MenuItem text="Actualizar seleccionado" onAction="#actualizar"/>
            <MenuItem text="Eliminar seleccionado" onAction="#eliminar"/>
        <SeparatorMenuItem/>
        <MenuItem text="Refrescar" onAction="#refrescar"/>
    </items>
          </ContextMenu>
        </contextMenu>
      </TableView>
      <Label fx:id="lblEstado" text="Nuevo registro"/>
    </VBox>
  </center>
</BorderPane>
