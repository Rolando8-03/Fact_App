<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.fact_app.controller.CategoriaController">

    <!-- TÍTULO -->
    <top>

        <Label style="-fx-font-size: 22px;                       -fx-font-weight: bold;" text="Gestión de categorías" BorderPane.alignment="CENTER">

            <padding>

                <Insets bottom="15" left="10" right="10" top="15" />

            </padding>

        </Label>

    </top>


    <!-- CONTENIDO -->
    <center>

        <VBox spacing="15">

            <padding>

                <Insets bottom="20" left="25" right="25" top="15" />

            </padding>


            <!--
                DATOS PRINCIPALES EN UNA SOLA FILA
                PARA APROVECHAR MEJOR EL ESPACIO
            -->
            <HBox alignment="CENTER_LEFT" spacing="25">


                <!-- NOMBRE -->
                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">

                    <Label text="Nombre *:" />

                    <TextField fx:id="txtNombre" prefWidth="300" promptText="Nombre de la categoría" HBox.hgrow="ALWAYS" />

                </HBox>


                <!-- ESTADO -->
                <HBox alignment="CENTER_LEFT" spacing="10">

                    <Label text="Estado:" />

                    <CheckBox fx:id="chkActiva" text="Categoría activa" />

                </HBox>

            </HBox>


            <!--
                CAMPOS OBLIGATORIOS + FILTRO + GUARDAR
            -->
            <HBox alignment="CENTER_LEFT" spacing="20">


                <Label style="-fx-text-fill: #b00020;" text="* Campos obligatorios" />


                <CheckBox fx:id="chkVerTodos" onAction="#filtrarCategorias" selected="true" text="Ver todos" />


                <Region HBox.hgrow="ALWAYS" />


                <Button fx:id="btnGuardar" onAction="#guardar" text="Guardar">


                    <graphic>

                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">

                            <image>

                                <Image url="@../icons/agregar.png" />

                            </image>

                        </ImageView>

                    </graphic>

                </Button>

            </HBox>


            <!-- TABLA -->
            <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS">


                <columns>

                    <TableColumn fx:id="colNombre" prefWidth="430" text="Nombre" />


                    <!--
                        ESTA COLUMNA SE MANTIENE,
                        TAL COMO PEDISTE.
                    -->
                    <TableColumn fx:id="colActiva" prefWidth="160" text="Activa" />

                </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

            </TableView>

        </VBox>

    </center>

</BorderPane>
